# Serveur
PORT=4000
NODE_ENV=development

# Origines autorisées (séparées par des virgules) — le domaine de ton frontend
CORS_ORIGIN=http://localhost:5173
# Utilisé pour construire les liens dans les emails (vérification, reset)
FRONTEND_URL=http://localhost:5173

# --- Base de données (Phase 1) ---
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://amphix_meet_db_user:ZL8G8BkEUmSqKP2tGszZQJI0Ba9qYUwl@dpg-da3l08k9v7es739064gg-a/amphix_meet_db

# --- Authentification (Phase 1) ---
# Génère une valeur aléatoire longue, ex: `openssl rand -hex 32`
JWT_ACCESS_SECRET=156d81cb8bce4e5e6b48e34d72fb95d334f226f5f6d0c271791e7584bcd66e63

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Email (Phase 1) ---
# ⚠️ emailService.ts est un STUB qui log dans la console — aucun email
# n'est réellement envoyé tant que tu n'as pas branché un vrai
# fournisseur (Resend, SendGrid, Postmark…). Rien à configurer ici pour
# l'instant, cette section est un pense-bête pour plus tard.

# LiveKit (à récupérer sur https://cloud.livekit.io)
LIVEKIT_URL=wss://votre-projet.livekit.cloud
LIVEKIT_API_KEY=votre_api_key
LIVEKIT_API_SECRET=votre_api_secret

# Durée de validité des tokens LiveKit (en secondes). Un plancher de 3h
# (10800s) est imposé côté code (livekitService.ts) quoi que tu mettes ici
# en dessous.
TOKEN_TTL_SECONDS=21600

# Limitation de requêtes
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30